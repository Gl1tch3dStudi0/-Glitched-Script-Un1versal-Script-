-- ============================================================
-- DESTROY ON X
-- ============================================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.X then
        -- kill rayfield UI
        pcall(function()
            if Rayfield and Rayfield.destroy then Rayfield:destroy() end
        end)
        -- nuke our GUIs
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, obj in ipairs(pg:GetChildren()) do
                local n = obj.Name
                if n == "kWarriorWatermark" or n == "kEspCanvas"
                    or n == "kFovCircle" or n == "Rayfield"
                    or n == "FlyGuiV3" or n == "FlyGUI" then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        -- restore lighting
        pcall(function()
            Lighting.Ambient        = Color3.fromRGB(70,70,70)
            Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
            Lighting.Brightness     = 1
            Lighting.GlobalShadows  = true
        end)
        notif("Glitched Studios", "destroyed")
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        shiftLockOn = not shiftLockOn
        local hum = getHum()
        if hum then
            hum.CameraOffset = shiftLockOn and Vector3.new(1.75, 0.5, 0) or Vector3.zero
            hum.AutoRotate = true
        end
    end
end)

-- ============================================================
-- FLY LOADER
-- ============================================================
local FLY_URL = "https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt"

local function loadExternalFly()
    if FLY.loaded then notif("Glitched Studios", "fly already loaded") return end
    notif("Glitched Studios", "loading fly...")
    local ok, err = pcall(function()
        local src = game:HttpGet(FLY_URL)
        src = src:gsub("Made by [Xx][Nn][Ee][Oo]", "Made by Warrior")
        src = src:gsub("made by [Xx][Nn][Ee][Oo]", "made by Warrior")
        src = src:gsub("[Xx][Nn][Ee][Oo]FF", "Warrior")
        src = src:gsub("[Xx][Nn][Ee][Oo]", "Warrior")
        src = src:gsub("xneo", "warrior")
        src = src:gsub("XNEO", "WARRIOR")
        local fn = loadstring(src)
        if not fn then error("loadstring returned nil") end
        fn()
    end)
    if ok then
        FLY.loaded = true
        notif("Glitched Studios", "fly loaded")
    else
        notif("Glitched Studios", "fly failed -- see console")
        warn("[GS] fly error:", err)
    end
end

